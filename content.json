      "items": [
        {
          "id": "1",
          "icon": "Wine",
          "title": {
            "he": "יינות ברמה גבוהה",
            "en": "יינות ברמה גבוהה"
          },
          "desc": {
            "he": "מבחר יינות מקומיים וחו\"ל, מיקבים ישראליים מובחרים ועד ליבואים בינלאומיים. כל בקבוק נבחר בעיון, להבטיח טעם וטוב איכות בכל הטווח המחירי.",
            "en": "מבחר יינות מקומיים וחו\"ל, מיקבים ישראליים מובחרים ועד ליבואים בינלאומיים. כל בקבוק נבחר בעיון, להבטיח טעם וטוב איכות בכל הטווח המחירי."
          }
        },
        {
          "id": "2",
          "icon": "Beer",
          "title": {
            "he": "בירות מגוונות",
            "en": "בירות מגוונות"
          },
          "desc": {
            "he": "בחירה רחבה של בירות מקליפורניה, אירופה והארץ. מביצועים קלים וריפרישים עד לאפעילס עמוקים וממוחזרים, כולם זמינים בהנחות פסטיבל.",
            "en": "בחירה רחבה של בירות מקליפורניה, אירופה והארץ. מביצועים קלים וריפרישים עד לאפעילס עמוקים וממוחזרים, כולם זמינים בהנחות פסטיבל."
          }
        },
        {
          "id": "3",
          "icon": "Sparkles",
          "title": {
            "he": "וויסקי וזיקוקים",
            "en": "וויסקי וזיקוקים"
          },
          "desc": {
            "he": "אוסף קיורטוריום של וויסקיים סקוטיים פרימיום, טקילה, וודקה וקוניאק. כל קטגוריה מזדהה בחדקנות לאספנים ולתיקים כאחד.",
            "en": "אוסף קיורטוריום של וויסקיים סקוטיים פרימיום, טקילה, וודקה וקוניאק. כל קטגוריה מזדהה בחדקנות לאספנים ולתיקים כאחד."
          }
        },
        {
          "id": "4",
          "icon": "Gift",
          "title": {
            "he": "מארזים ומתנות",
            "en": "מארזים ומתנות"
          },
          "desc": {
            "he": "חבילות מעוצבות לאירועים, חגים ומתנות אישיות. כל מארז מוכן בתשומת לב, מושלם לחגיגה או לתיאום אחרון.",
            "en": "חבילות מעוצבות לאירועים, חגים ומתנות אישיות. כל מארז מוכן בתשומת לב, מושלם לחגיגה או לתיאום אחרון."
          }
        },
        {
          "id": "5",
          "icon": "Truck",
          "title": {
            "he": "משלוח מהיר בגוש דן",
            "en": "משלוח מהיר בגוש דן"
          },
          "desc": {
            "he": "משלוח חינם בהזמנות מעל 299 שקל לרחבי גוש דן. עמידה בלוח הזמנים מדויקת וטיפול בזהירות מלאה, מהחנות לדלת ביתך.",
            "en": "משלוח חינם בהזמנות מעל 299 שקל לרחבי גוש דן. עמידה בלוח הזמנים מדויקת וטיפול בזהירות מלאה, מהחנות לדלת ביתך."
          }
        },
        {
          "id": "6",
          "icon": "ShoppingCart",
          "title": {
            "he": "קנייה מקוונת בנוחות",
            "en": "קנייה מקוונת בנוחות"
          },
          "desc": {
            "he": "חנות דיגיטלית מלאה עם זמנים מהירים. בחר ממנוחת ביתך, בדוק מחירים ומעודכנויות מבצע, וסיים את ההזמנה בשניות.",
            "en": "חנות דיגיטלית מלאה עם זמנים מהירים. בחר ממנוחת ביתך, בדוק מחירים ומעודכנויות מבצע, וסיים את ההזמנה בשניות."
          }
